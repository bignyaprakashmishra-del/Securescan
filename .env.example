# SecureScan Environment Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL on Render or local, or SQLite for local dev without postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/securescan?schema=public"

# Secrets (Render generates these automatically in production)
JWT_SECRET="securescan_dev_jwt_secret_key_change_in_production_987654321"
COOKIE_SECRET="securescan_dev_cookie_secret_key_change_in_production_123456789"
